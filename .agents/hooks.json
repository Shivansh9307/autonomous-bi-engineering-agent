{
  "bi-verification-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "..\\.venv\\Scripts\\python.exe -m bi_agent.hooks.pre_tool_guard",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "..\\.venv\\Scripts\\python.exe -m bi_agent.hooks.post_tool_audit",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
