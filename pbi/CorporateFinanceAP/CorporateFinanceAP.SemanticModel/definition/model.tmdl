model CorporateFinanceAP
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_ProTooling = ["MCP-PBIModeling","DevMode"]

annotation __TEdtr = 1

annotation PBI_QueryOrder = ["DimDate","DimVendor","DimCostCenter","DimGLAccount","DimApprover","FactAPInvoices","FactAPBudget","_Measures","DataFolder"]

annotation __PBI_TimeIntelligenceEnabled = 0

ref table DimDate
ref table DimVendor
ref table DimCostCenter
ref table DimGLAccount
ref table DimApprover
ref table FactAPInvoices
ref table FactAPBudget
ref table _Measures

ref role BU_NorthAmerica
ref role BU_Europe
ref role BU_APAC
ref role Dynamic_Approver

