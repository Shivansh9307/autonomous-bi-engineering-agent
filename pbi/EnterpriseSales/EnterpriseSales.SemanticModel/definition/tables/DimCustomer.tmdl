/// Customer account dimension with segment and region attributes.
table DimCustomer
	lineageTag: 88b54510-7f26-46fc-a05a-c7f625f8ad6a

	column CustomerKey
		dataType: int64
		isHidden
		isAvailableInMdx: false
		lineageTag: 68b37339-e4c8-4f14-8314-f18c6e18afcd
		summarizeBy: none
		sourceColumn: CustomerKey

	column CustomerCode
		dataType: string
		lineageTag: 62e9e67b-7eb0-4f3e-8fe7-0e7ad5517c4e
		summarizeBy: none
		sourceColumn: CustomerCode

	column CustomerName
		dataType: string
		lineageTag: 0e038a45-8781-49d9-8ba5-d126ea2afc50
		summarizeBy: none
		sourceColumn: CustomerName

	column Segment
		dataType: string
		lineageTag: 51affd86-57ce-410f-a9b8-b6e02bfef47d
		summarizeBy: none
		sourceColumn: Segment

	column Region
		dataType: string
		lineageTag: ffe53d11-18b0-452b-ac78-99992fd2667e
		summarizeBy: none
		sourceColumn: Region

	partition DimCustomer = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\DimCustomer.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {
				        {"CustomerKey", Int64.Type},
				        {"CustomerCode", type text},
				        {"CustomerName", type text},
				        {"Segment", type text},
				        {"Region", type text}
				    }, "en-US")
				in
				    #"Changed Type"

