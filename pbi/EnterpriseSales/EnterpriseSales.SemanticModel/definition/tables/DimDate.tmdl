/// Calendar date dimension table covering 2024-2026.
table DimDate
	lineageTag: 22d04b15-0da0-4947-98a6-1cb3da61cfc1
	dataCategory: Time

	column DateKey
		dataType: int64
		isHidden
		isAvailableInMdx: false
		lineageTag: 4c708fc7-c165-438e-8b7e-ed28f96123da
		summarizeBy: none
		sourceColumn: DateKey

	column Date
		dataType: dateTime
		isUnique
		formatString: yyyy-mm-dd
		lineageTag: b35880a9-cd4c-453e-9c54-a1a84cc32a48
		summarizeBy: none
		sourceColumn: Date

	column Year
		dataType: int64
		formatString: 0
		lineageTag: b055cd65-3421-4a49-94f0-230ab75dec75
		summarizeBy: none
		sourceColumn: Year

	column Quarter
		dataType: string
		lineageTag: bc1dec2e-b505-4a9c-a516-b1a0d74fa0e6
		summarizeBy: none
		sourceColumn: Quarter
		sortByColumn: QuarterNumber

	column QuarterNumber
		dataType: int64
		isHidden
		lineageTag: 036edee1-4fbd-4142-9ac9-74c0f9cb2424
		summarizeBy: none
		sourceColumn: QuarterNumber

	column MonthNumber
		dataType: int64
		isHidden
		lineageTag: 3ebfc571-f549-40fb-8cfa-c0287d22a025
		summarizeBy: none
		sourceColumn: MonthNumber

	column MonthName
		dataType: string
		lineageTag: d56ee36b-6199-4297-9d79-c76a1f78bb00
		summarizeBy: none
		sourceColumn: MonthName
		sortByColumn: MonthNumber

	column YearMonth
		dataType: string
		lineageTag: 25495b15-bc46-45af-8d66-4ac5d80d10ce
		summarizeBy: none
		sourceColumn: YearMonth
		sortByColumn: YearMonthSort

	column YearMonthSort
		dataType: int64
		isHidden
		lineageTag: e6dc9c4d-a505-41a3-9e4e-fa62559d1b76
		summarizeBy: none
		sourceColumn: YearMonthSort

	column DayOfWeek
		dataType: string
		lineageTag: 28cd1827-ce67-43be-aa12-2242050efe5e
		summarizeBy: none
		sourceColumn: DayOfWeek

	column IsWeekend
		dataType: int64
		formatString: 0
		lineageTag: 598765d1-58af-4232-824c-380ba88c25bb
		summarizeBy: none
		sourceColumn: IsWeekend

	hierarchy 'Calendar Hierarchy'
		lineageTag: 38cfccf9-f246-4e88-b64f-44be463800cc

		level Year
			lineageTag: a13fdcea-8496-4e69-a1f6-130b0a5888d8
			column: Year

		level Quarter
			lineageTag: 2a33ac4c-ef76-4ed1-94d3-d7ab63c6f40b
			column: Quarter

		level MonthName
			lineageTag: caa18b34-dd2c-4ca7-894f-1c24cec47b80
			column: MonthName

	partition DimDate = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\DimDate.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {
				        {"DateKey", Int64.Type},
				        {"Date", type date},
				        {"Year", Int64.Type},
				        {"Quarter", type text},
				        {"QuarterNumber", Int64.Type},
				        {"MonthNumber", Int64.Type},
				        {"MonthName", type text},
				        {"YearMonth", type text},
				        {"YearMonthSort", Int64.Type},
				        {"DayOfWeek", type text},
				        {"IsWeekend", Int64.Type}
				    }, "en-US")
				in
				    #"Changed Type"

