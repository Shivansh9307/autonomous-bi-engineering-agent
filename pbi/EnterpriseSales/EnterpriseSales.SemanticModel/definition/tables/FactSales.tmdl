	partition FactSales = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\FactSales.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {
				        {"SalesOrderID", type text},
				        {"OrderLineNumber", Int64.Type},
				        {"DateKey", Int64.Type},
				        {"ProductKey", Int64.Type},
				        {"StoreKey", Int64.Type},
				        {"CustomerKey", Int64.Type},
				        {"SalesRepKey", Int64.Type},
				        {"Quantity", Int64.Type},
				        {"UnitPrice", Currency.Type},
				        {"UnitCost", Currency.Type},
				        {"GrossAmount", Currency.Type},
				        {"DiscountRate", Currency.Type},
				        {"DiscountAmount", Currency.Type},
				        {"NetRevenue", Currency.Type},
				        {"COGS", Currency.Type}
				    }, "en-US")
				in
				    #"Changed Type"

